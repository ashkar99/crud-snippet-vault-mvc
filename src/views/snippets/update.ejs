<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Edit Snippet</h4>
            </div>
            <div class="card-body">
                <form action="/snippets/<%= viewData.snippet._id %>/update" method="POST">
                    <div class="mb-3">
                        <label for="title" class="form-label fw-bold">Snippet Title</label>
                        <input type="text" class="form-control" id="title" name="title" required maxlength="100" value="<%= viewData.snippet.title %>">
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label fw-bold">Code Content</label>
                        <textarea class="form-control font-monospace" id="content" name="content" rows="12" required><%= viewData.snippet.content %></textarea>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/snippets/<%= viewData.snippet._id %>" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning">Update Snippet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>