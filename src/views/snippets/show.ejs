<div class="mb-3">
    <a href="/snippets" class="text-decoration-none">← Back to Feed</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><%= viewData.snippet.title %></h4>
        <small>Author: <%= viewData.snippet.author.username %></small>
    </div>
    <div class="card-body">
        <div class="snippet-content"><%= viewData.snippet.content %></div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center bg-white">
        <div>
            <small class="text-muted d-block">Created: <%= new Date(viewData.snippet.createdAt).toLocaleString() %></small>
            <% if (String(viewData.snippet.createdAt) !== String(viewData.snippet.updatedAt)) { %>
                <small class="text-muted d-block">Updated: <%= new Date(viewData.snippet.updatedAt).toLocaleString() %></small>
            <% } %>
        </div>
        
        <% if (locals.user && locals.user._id === viewData.snippet.author._id.toString()) { %>
            <div>
                <a href="/snippets/<%= viewData.snippet._id %>/update" class="btn btn-warning btn-sm me-2">Edit</a>
                <a href="/snippets/<%= viewData.snippet._id %>/delete" class="btn btn-danger btn-sm">Delete</a>
            </div>
        <% } %>
    </div>
</div>