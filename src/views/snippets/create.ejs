<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Create New Snippet</h4>
            </div>
            <div class="card-body">
                <form action="/snippets/create" method="POST">
                    <div class="mb-3">
                        <label for="title" class="form-label fw-bold">Snippet Title</label>
                        <input type="text" class="form-control" id="title" name="title" required maxlength="100" placeholder="e.g., Mongoose Connection Logic">
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label fw-bold">Code Content</label>
                        <textarea class="form-control font-monospace" id="content" name="content" rows="12" required placeholder="Paste your code here..."></textarea>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/snippets" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Snippet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>