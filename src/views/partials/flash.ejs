<% if (locals.success_message && locals.success_message.length > 0) { %>
    <% success_message.forEach(function(msg) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% }) %>
<% } %>

<% if (locals.error_message && locals.error_message.length > 0) { %>
    <% error_message.forEach(function(msg) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% }) %>
<% } %>

<% if (locals.flash && locals.flash.text) { %>
    <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show" role="alert">
        <%= flash.text %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>